# Copy to .env.production, set real values there, and keep it out of version control.
STUDIO_PUBLIC_ORIGIN=https://studio.example.com
STUDIO_DATABASE_URL=postgresql://studio_runtime:replace-me@db.example.com:5432/studio?sslmode=verify-full
STUDIO_SIGNING_KEY=replace-with-a-private-random-key-of-at-least-32-bytes
STUDIO_METRICS_TOKEN=
STUDIO_S3_BUCKET=replace-with-private-bucket
STUDIO_S3_PREFIX=studio
AWS_REGION=us-east-1

STUDIO_REPLICATE_TOKEN=
STUDIO_REPLICATE_WEBHOOK_SECRET=
STUDIO_REPLICATE_SCRIPT_MODEL=
STUDIO_REPLICATE_IMAGE_MODEL=
STUDIO_REPLICATE_VIDEO_MODEL=
STUDIO_REPLICATE_SCRIPT_PROMPT_FIELD=prompt
STUDIO_REPLICATE_IMAGE_PROMPT_FIELD=prompt
STUDIO_REPLICATE_VIDEO_PROMPT_FIELD=prompt
STUDIO_REPLICATE_SCRIPT_INPUT={}
STUDIO_REPLICATE_IMAGE_INPUT={}
STUDIO_REPLICATE_VIDEO_INPUT={}

STUDIO_SCRIPT_CREDITS=1
STUDIO_IMAGE_CREDITS=4
STUDIO_VIDEO_CREDITS=12
STUDIO_MEDIA_DEADLINE_SECONDS=900
STUDIO_MAX_MEDIA_MB=48
